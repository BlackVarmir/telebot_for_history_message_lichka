# Telegram Client API (отримайте на https://my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash

# Telegram Bot API (отримайте у @BotFather)
BOT_TOKEN=your_bot_token

# ===== STORAGE CONFIGURATION =====
# Виберіть один з варіантів: SFTP (legacy) або S3 (рекомендовано)

# Варіант 1: SFTP Storage Box (Hetzner) - LEGACY
# STORAGE_TYPE=sftp
# STORAGE_BOX_HOST=your_host.your-storagebox.de
# STORAGE_BOX_USERNAME=your_username
# STORAGE_BOX_PASSWORD=your_password
# STORAGE_BOX_PATH=/backup/telegram_bot/

# Варіант 2: Object Storage (Hetzner S3-compatible) - РЕКОМЕНДОВАНО
STORAGE_TYPE=s3
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=telegram-bot-backup
S3_REGION=fsn1  # fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki)
S3_PREFIX=telegram-bot/  # Папка в bucket (опціонально, залиште пустим для root)

# AI API Keys - опціонально
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
AI_PROVIDER=openai  # "openai" або "anthropic"

# Timezone
TZ=Europe/Kiev

